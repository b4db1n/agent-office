{
  "name": "office-steward",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Office Steward: an office for your OpenCode team, in OpenChamber and the terminal.",
  "bin": {
    "office-steward": "./companion/cli.mjs",
    "agent-office": "./companion/cli.mjs"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.8.0"
    },
    "id": "agent-office",
    "name": "Office Steward",
    "icon": "team",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "panel/index.html",
        "title": "Office Steward",
        "requiresProject": true
      },
      "background": {
        "entry": "background/index.html"
      },
      "actions": [
        {
          "id": "dispatch",
          "label": "Ask Office lead",
          "where": "message",
          "roles": [
            "user"
          ],
          "mode": "background"
        }
      ],
      "opencodePlugin": "plugin",
      "capabilities": [
        "sessions"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "opencode"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "openchamber-guest-bundle panel/main.ts panel/main.js && openchamber-guest-bundle background/main.ts background/main.js && openchamber-guest-bundle --node service/main.ts service/main.js && bun build plugin/source.ts --target=node --format=esm --outfile=plugin/index.js",
    "test": "bun test",
    "test:panel": "playwright install chromium && bun test tests/panel.test.mjs",
    "check": "openchamber-guest-check"
  },
  "dependencies": {
    "@openchamber/sdk": "2.8.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4db1n/office-steward.git"
  },
  "homepage": "https://github.com/b4db1n/office-steward#readme",
  "bugs": {
    "url": "https://github.com/b4db1n/office-steward/issues"
  },
  "devDependencies": {
    "playwright": "1.60.0"
  }
}
